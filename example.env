# ---------------------------------------------------------------------------
# SMTP Email Dispatcher Authentication
# ---------------------------------------------------------------------------
# Required for sending automated email build reports and notifications.
# NOTE: If using Gmail, you must generate a dedicated 16-character App Password
# (requires 2-Step Verification): https://myaccount.google.com/apppasswords
# Do NOT use your standard account login password.
# Run the edit email settings wizzard on the web portal after adding secrets here
# ---------------------------------------------------------------------------

SMTP_USERNAME=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Google Play Authentication (Required for Play Store downloads on Oracle Servers)
# ---------------------------------------------------------------------------
# If you are having issues with Google Play downloads, add an email and AAS below
#
# WARNING: Use a dedicated, disposable Google account — never your primary account.
#
# Setup guide to generate an AAS token
# https://github.com/EFForg/apkeep/blob/master/USAGE-google-play.md
# ---------------------------------------------------------------------------

GOOPDL_ACCOUNT_EMAIL=
GOOPDL_AAS_TOKEN=

# ---------------------------------------------------------------------------
# GitHub Personal Access Token (Optional)
# ---------------------------------------------------------------------------
# Optional: Used to authenticate API requests when querying patch repositories
# and releases to bypass GitHub's strict anonymous rate limits (60 req/hr).
#
# Unlikely to be required unless you are querying large number of repos
#
# Create a classic or fine-grained token (no special permissions required):
# https://github.com/settings/tokens
# ---------------------------------------------------------------------------

GITHUB_TOKEN=
 
# ---------------------------------------------------------------------------
# Outside / Base URL (Optional)
# ---------------------------------------------------------------------------
# Dashboard and delivery host bindings (Docker Compose)
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_PORT=8080
DELIVERY_BIND_HOST=127.0.0.1
DELIVERY_PORT=8081

# Delivery URL used for APK links, Obtainium, and F-Droid when not using tunnels.
# For direct LAN delivery, set DELIVERY_BIND_HOST=0.0.0.0 and use a URL such as
# http://192.168.1.100:8081. For a reverse proxy, use its external HTTPS URL.
BASE_URL=

# ---------------------------------------------------------------------------
# Upstream Proxy Configuration (Optional)
# ---------------------------------------------------------------------------
# HTTP or SOCKS5 proxy used for upstream connections:
# APKPure, APKMirror, APKCombo, Uptodown, Aptoide, Google Play (goopdl),
# GitHub releases, and other external APK fetching services.
#
# Leave empty for direct connections.
#
# Examples:
#   http://127.0.0.1:8080
#   http://username:password@proxyserver.com:8080
#   socks5://127.0.0.1:1080
#   socks5h://127.0.0.1:1080 (remote DNS resolution through proxy)
# ---------------------------------------------------------------------------
PROXY_URL=

# Comma-separated list of hosts/domains that should bypass the proxy.
# Note: localhost, 127.0.0.1, and flaresolverr are always bypassed automatically.
# Example: 192.168.1.0/24,internal.domain.com
BYPASS_PROXY=

# ---------------------------------------------------------------------------
# FlareSolverr Configuration (Optional)
# ---------------------------------------------------------------------------
# Used to bypass Cloudflare bot protection on APKMirror, APKCombo, and other sources.
# To start the built-in FlareSolverr container in Docker:
#   Add 'flaresolverr' to COMPOSE_PROFILES below (e.g. COMPOSE_PROFILES=flaresolverr)
#   and set FLARESOLVERR_URL=http://flaresolverr:8191/v1
# Or for an external FlareSolverr instance:
#   FLARESOLVERR_URL=http://localhost:8191/v1
# ---------------------------------------------------------------------------
FLARESOLVERR_URL=

# ---------------------------------------------------------------------------
# Compose Profiles & Tunnel Credentials (Optional)
# ---------------------------------------------------------------------------
# Profiles: cloudflare, pangolin, tailscale, flaresolverr (combine with commas if using multiple)
# e.g. COMPOSE_PROFILES=flaresolverr

COMPOSE_PROFILES=

CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_URL=

PANGOLIN_ENDPOINT=
PANGOLIN_ID=
PANGOLIN_SECRET=
PANGOLIN_URL=

TAILSCALE_FUNNEL_URL=
