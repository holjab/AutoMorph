# ---------------------------------------------------------------------------
# SMTP Email Dispatcher Authentication
# ---------------------------------------------------------------------------
# Required for sending automated email build reports and notifications.
# NOTE: If using Gmail, you must generate a dedicated 16-character App Password
# (requires 2-Step Verification): https://myaccount.google.com/apppasswords
# Do NOT use your standard account login password.
# Run the edit email settings wizzard on the web portal after adding secrets here
# ---------------------------------------------------------------------------

SMTP_USERNAME=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Google Play Authentication (Required for Play Store downloads on Oracle Servers)
# ---------------------------------------------------------------------------
# If you are having issues with Google Play downloads, add an email and AAS below
#
# WARNING: Use a dedicated, disposable Google account — never your primary account.
#
# Setup guide to generate an AAS token
# https://github.com/EFForg/apkeep/blob/master/USAGE-google-play.md
# ---------------------------------------------------------------------------

GOOPDL_ACCOUNT_EMAIL=
GOOPDL_AAS_TOKEN=

# ---------------------------------------------------------------------------
# GitHub Personal Access Token (Optional)
# ---------------------------------------------------------------------------
# Optional: Used to authenticate API requests when querying patch repositories
# and releases to bypass GitHub's strict anonymous rate limits (60 req/hr).
#
# Unlikely to be required unless you are querying large number of repos
#
# Create a classic or fine-grained token (no special permissions required):
# https://github.com/settings/tokens
# ---------------------------------------------------------------------------

GITHUB_TOKEN=
 
# ---------------------------------------------------------------------------
# Tunnel Profiles & Credentials (Optional)
# ---------------------------------------------------------------------------
# Options: cloudflare, pangolin, tailscale (combine with commas if using multiple)
# e.g. COMPOSE_PROFILES=cloudflare,pangolin

COMPOSE_PROFILES=

CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_URL=

PANGOLIN_ENDPOINT=
PANGOLIN_ID=
PANGOLIN_SECRET=
PANGOLIN_URL=

TAILSCALE_FUNNEL_URL=

# ---------------------------------------------------------------------------
# ntfy Push Notifications (optional)
# ---------------------------------------------------------------------------
# Independent of the SMTP dispatcher. NTFY_URL may be the bare server URL or a
# full "https://server/topic" URL. For protected topics put the access token
# into NTFY_TOKEN (recommended) or user/password into NTFY_USERNAME/NTFY_PASSWORD.
# These variables win over the values in config.yaml.
# ---------------------------------------------------------------------------

NTFY_ENABLED=
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_USERNAME=
NTFY_PASSWORD=